  "dashboard": [
    {
      "id": "sp-creation-count",
      "name": "Sentence plan creation volumes",
      "description": "<strong>Dataset coverage before applying filters</strong><br><br>Volume of sentence plans created by date and cumulative view, showing the breakdown percentage of each agreement status. Sentence plan must have at least 1 goal to be included.<br><br><strong>Available controls</strong><br><br>Date range via Date range picker, either specific start and end dates or Pre set date ranges.<br><br><em>The use cases listed below are representative examples and are not intended to be a comprehensive list.</em><br><br><strong>Supported Use cases:</strong><br><br> - Proportion of sentence plans that currently have an agreement status<br> - Sentence plans by their current status<br><br><strong> Use cases not yet supported:</strong><br><br> - Volume of Private beta or National roll out only plans have been created<br> - Volume of plans created only for Prison or Community<br> - Sentence plan status duration<br>",
      "dataset": "sentence-plan-volumes-by-date-range",
      "child": [
        {
          "dashboardId": "sp-by-month"
        },
        {
          "dashboardId": "sp-active-users"
        }
      ],
      "section": [
