  "report": [
    {
      "id": "sentence-plan-by-date-report",
      "name": "Sentence Plan creation date by prefiltered date ",
      "description": "<strong>Dataset coverage before applying filters</strong><br><br>A view of a plan by when they were created, what their latest status is and how many goals saved they have by their latest primary area of need.<br><br><strong>Available controls</strong><br><br>Date range picker (only available pre report request, temporary column removal, by agreement status, by goal volume, by two primary areas of need.<br><br><em>The use cases listed below are representative examples and are not intended to be a comprehensive list</em><br><br><strong>Supported Use cases:</strong><br><br> - Current most popular primary area of needs for goals<br> - Volume of goals currently saved to sentence plans<br><br><strong>Use cases not yet supported:</strong><br><br> - Volume of goals created per month<br> - Change frequency of primary area of need of a goal<br>",
      "classification": "Official",
      "version": "1.0.0",
      "render": "HTML",
      "dataset": "$ref:sentence-plan-by-date",
      "feature": [
