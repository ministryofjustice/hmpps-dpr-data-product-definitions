{
  "id": "sp001-sentence-plan-volumes",
  "name": "Sentence Plan data products",
  "description": "Sentence Plan creation count and page view",
  "metadata": {
    "author": "Data Hub",
    "owner": "Data Hub",
    "version": "0.3"
  },
  "datasource": [
    {
      "id": "datamart",
      "name": "datamart"
    }
  ],
  "dataset": [
    {
      "id": "active-users-count",
      "name": "Active users",
      "datasource": "datamart",
      "query": "WITH goals AS ( select created_by_user_id, count(*) AS goal_count FROM datamart.prisons.sentenceplanassessmentview_goal group by created_by_user_id ), STEPS AS ( select created_by_user_id, count(*) as step_count FROM datamart.prisons.sentenceplanassessmentview_step group by created_by_user_id ) SELECT a.created_by_user_id, count(a.id) AS agreement_count, goal_count, step_count FROM datamart.prisons.sentenceplanassessmentview_plan_agreement a LEFT JOIN goals g ON g.created_by_user_id = a.created_by_user_id LEFT JOIN steps s ON s.created_by_user_id = a.created_by_user_id GROUP BY a.created_by_user_id, goal_count, step_count ",
      "schema": {
        "field": [
          {
            "name": "created_by_user_id",
            "type": "string",
            "display": "User ID"
          },
          {
            "name": "agreement_count",
            "type": "int",
            "display": "Agreement"
          },
          {
            "name": "goal_count",
            "type": "int",
            "display": "Goal"
          },
          {
            "name": "step_count",
            "type": "int",
            "display": "Step"
          }
        ]
      }
    },
    {
      "id": "sp-by-month",
      "name": "SP by month",
      "datasource": "datamart",
      "query": "select trunc(date_trunc('month',p.created_at)) as ts, count(p.id) as monthly_count, SUM (monthly_count) over (order by ts rows unbounded preceding) AS total_to_date FROM datamart.prisons.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.prisons.sentenceplanassessmentview_sentence_plan_identifier i ON i.sentence_plan_id = p.id LEFT JOIN datamart.prisons.sentenceplanassessmentview_plan_agreement a ON a.sentence_plan_id = p.snapshot_id WHERE exists ( SELECT 1 FROM datamart.prisons.sentenceplanassessmentview_goal g WHERE g.sentence_plan_id = p.snapshot_id ) AND p.deleted = false GROUP BY ts ORDER BY ts",
      "schema": {
        "field": [
          {
            "name": "ts",
            "type": "timestamp",
            "display": "Date"
          },
          {
            "name": "monthly_count",
            "type": "int",
            "display": "Count"
          },
          {
            "name": "total_to_date",
            "type": "int",
            "display": "Total"
          }
        ]
      }
    },
    {
      "id": "sentence-plan-volumes-by-date-range",
      "name": "SP summary",
      "datasource": "datamart",
      "query": "  SELECT TRUNC(p.created_at) as ts, '$TBC' AS link, COUNT(p.id) as plan_count, COUNT(a.status) as agreement_count, COUNT( CASE WHEN a.status = 'AGREED' THEN 1 END ) AS agreed_count, COUNT( CASE WHEN a.status = 'COULD_NOT_ANSWER' THEN 1 END ) AS could_not_answer_count, COUNT( CASE WHEN a.status = 'DO_NOT_AGREE' THEN 1 END ) AS not_agreed_count, COUNT( CASE WHEN a.status = 'UPDATED_AGREED' THEN 1 END ) AS updated_agreed_count, COUNT( CASE WHEN a.status = 'UPDATED_COULD_NOT_AGREE' THEN 1 END ) AS updated_could_not_agree_count, SUM(plan_count) over ( order by ts rows unbounded preceding ) AS total_to_date, SUM(agreed_count) over ( order by ts rows unbounded preceding ) AS total_agreed, SUM(could_not_answer_count) over ( order by ts rows unbounded preceding ) AS total_could_not_answer, SUM(not_agreed_count) over ( order by ts rows unbounded preceding ) AS total_not_agreed, SUM(updated_agreed_count) over ( order by ts rows unbounded preceding ) AS total_updated_agreed, SUM(updated_could_not_agree_count) over ( order by ts rows unbounded preceding ) AS total_updated_could_not_agree, TO_CHAR( total_not_agreed::FLOAT4 / total_to_date::FLOAT4 * 100, 'FM999990.00' ) || '%' AS not_agreed_pct, TO_CHAR( total_agreed::FLOAT4 / total_to_date::FLOAT4 * 100, 'FM999990.00' ) || '%' AS agreed_pct, TO_CHAR( total_could_not_answer::FLOAT4 / total_to_date::FLOAT4 * 100, 'FM999990.00' ) || '%' AS could_not_answer_pct, TO_CHAR( total_updated_could_not_agree::FLOAT4 / total_to_date::FLOAT4 * 100, 'FM999990.00' ) || '%' AS updated_could_not_agree_pct, TO_CHAR( total_updated_agreed::FLOAT4 / total_to_date::FLOAT4 * 100, 'FM999990.00' ) || '%' AS updated_agreed_pct, SUM(agreement_count) over ( order by ts rows unbounded preceding ) AS total_agreement, TO_CHAR( total_agreement::FLOAT4 / total_to_date::FLOAT4 * 100, 'FM999990.00' ) || '%' AS agreement_pct FROM datamart.probation.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.probation.sentenceplanassessmentview_sentence_plan_identifier i ON i.sentence_plan_id = p.id LEFT JOIN datamart.probation.sentenceplanassessmentview_plan_agreement a ON a.sentence_plan_id = p.snapshot_id WHERE exists ( SELECT 1 FROM datamart.probation.sentenceplanassessmentview_goal g WHERE g.sentence_plan_id = p.snapshot_id ) AND p.deleted = false GROUP BY ts ORDER BY ts",
      "schema": {
        "field": [
          {
            "name": "ts",
            "type": "timestamp",
            "display": "Date",
            "filter": {
              "index": 1,
              "interactive": true,
              "type": "daterange",
              "max": "today()",
              "default": "today(-3, months) - today()"
            }
          },
          {
            "name": "link",
            "type": "string",
            "display": "Link",
            "formula": "make_url('/dpr/request-report/report/dpr_sp001-sentence-plan-volumes/sentence-plan-by-date-report/filters?filters.created_at.start=${ts}&filters.created_at.end=${ts}',${plan_count},TRUE)"
          },
          {
            "name": "plan_count",
            "type": "int",
            "display": "Count"
          },
          {
            "name": "agreement_count",
            "type": "int",
            "display": "Vol of agreements"
          },
          {
            "name": "agreed_count",
            "type": "int",
            "display": "Vol agreed"
          },
          {
            "name": "could_not_answer_count",
            "type": "int",
            "display": "Vol could not answer"
          },
          {
            "name": "not_agreed_count",
            "type": "int",
            "display": "Vol not agreed"
          },
          {
            "name": "updated_agreed_count",
            "type": "int",
            "display": "Vol updated agreed"
          },
          {
            "name": "updated_could_not_agree_count",
            "type": "int",
            "display": "Vol updated could not agree"
          },
          {
            "name": "total_to_date",
            "type": "int",
            "display": "Total created to date"
          },
          {
            "name": "total_agreed",
            "type": "int",
            "display": "Total Agreed"
          },
          {
            "name": "total_not_agreed",
            "type": "int",
            "display": "Total not agreed"
          },
          {
            "name": "total_could_not_answer",
            "type": "int",
            "display": "Total could not answer"
          },
          {
            "name": "total_updated_agreed",
            "type": "int",
            "display": "Total updated agreed"
          },
          {
            "name": "total_updated_could_not_agree",
            "type": "int",
            "display": "Total updated could not agree"
          },
          {
            "name": "not_agreed_pct",
            "type": "string",
            "display": "Not agreed (%)"
          },
          {
            "name": "agreed_pct",
            "type": "float",
            "display": "Agreed"
          },
          {
            "name": "could_not_answer_pct",
            "type": "string",
            "display": "Could not answer"
          },
          {
            "name": "updated_could_not_agree_pct",
            "type": "string",
            "display": "Updated could not agree"
          },
          {
            "name": "updated_agreed_pct",
            "type": "string",
            "display": "Updated agreed"
          },
          {
            "name": "total_agreement",
            "type": "int",
            "display": "Total Agreements"
          },
          {
            "name": "agreement_pct",
            "type": "float",
            "display": "Plans with an agreement status"
          }
        ]
      }
    },
    {
      "id": "sentence-plan-by-date",
      "name": "Sentence Plan active detail",
      "datasource": "datamart",
      "query": "SELECT p.id, TRUNC(p.created_at) as ts, trunc(p.updated_at) AS updated_at, CASE WHEN a.status IS NULL THEN 'DRAFT' ELSE a.status END AS status, region_code, COUNT(CASE WHEN g.area_of_need = 'ACCOMMODATION' THEN 1 END) AS accommodation_count, COUNT(CASE WHEN g.area_of_need = 'DRUG_USE' THEN 1 END) AS drug_count, COUNT(CASE WHEN g.area_of_need = 'FINANCES' THEN 1 END) AS finance_count, COUNT(CASE WHEN g.area_of_need = 'ALCOHOL_USE' THEN 1 END) AS alcohol_count, COUNT(CASE WHEN g.area_of_need = 'HEALTH_AND_WELLBEING' THEN 1 END) AS health_count, COUNT(CASE WHEN g.area_of_need = 'PERSONAL_RELATIONSHIPS_AND_COMMUNITY' THEN 1 END) AS personal_count, COUNT(CASE WHEN g.area_of_need = 'EMPLOYMENT_AND_EDUCATION' THEN 1 END) AS employment_count, COUNT(CASE WHEN g.area_of_need = 'THINKING_BEHAVIOURS_AND_ATTITUDES' THEN 1 END) AS thinking_count, count(g.id) as total_goal_count FROM datamart.prisons.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.prisons.sentenceplanassessmentview_goal g ON  g.sentence_plan_id = p.snapshot_id LEFT JOIN datamart.prisons.sentenceplanassessmentview_plan_agreement a ON  a.sentence_plan_id = p.snapshot_id GROUP BY  (p.id, ts,p.updated_at, a.status,region_code)",
      "schema": {
        "field": [
          {
            "name": "id",
            "type": "string",
            "display": "ID"
          },
          {
            "name": "ts",
            "type": "date",
            "display": "Sentence plans created"
          },
          {
            "name": "updated_at",
            "type": "string",
            "display": "Area of need"
          },
          {
            "name": "status",
            "type": "string",
            "display": "Status"
          },
          {
            "name": "region_code",
            "type": "string",
            "display": ""
          },
          {
            "name": "accommodation_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "drug_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "finance_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "alcohol_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "health_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "personal_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "employment_count",
            "type": "string",
            "display": ""
          },
          {
            "name": "thinking_count",
            "type": "string",
            "display": "thinking_count"
          },
          {
            "name": "total_goal_count",
            "type": "int",
            "display": "Goals"
          }
        ]
      }
    }
  ],
