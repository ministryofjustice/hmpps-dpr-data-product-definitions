{
    "id": "apc001-referral-summary",
    "name": "Referral statistics associated with the Building Choices (BC) programme",
    "description": "Filter referrals by various associated parameters, So that you can analyse the current state of programme referrals",
    "metadata": {
        "author": "DPR",
        "owner": "DPR",
        "version": "0.1"
    },
    "datasource": [
        {
            "id": "athena_apc",
            "name": "Athena APC",
            "database": "public",
            "catalog": "dps_acc_pro_custody",
            "connection": "federated",
            "dialect": "postgres/19"
        },
        {
            "id": "datamart",
            "name": "datamart"
        },
        {
            "id": "athena_redshift",
            "name": "athena_redshift_federated",
            "database": "datamart",
            "catalog": "redshift_datamart",
            "connection": "federated",
            "dialect": "redshift/4"
        },
        {
            "id": "athena",
            "name": "athena",
            "database": "reports",
            "catalog": "AwsDataCatalog",
            "connection": "awsdatacatalog"
        }
    ],
    "dataset": [
        {
            "id": "referral-summary",
            "name": "Referral summary",
            "datasource": "athena_apc",
            "query": "SELECT c.name AS course_name, c.audience AS audience, r.status AS status, o.organisation_id, COUNT(r.referral_id) AS referral_count FROM referral r LEFT JOIN offering o ON r.offering_id = o.offering_id LEFT JOIN course c ON o.course_id = c.course_id WHERE r.deleted = FALSE AND (submitted_on) >= (SELECT START_DATE from prompt_) and (submitted_on) <= (SELECT END_DATE from prompt_) GROUP BY CUBE (c.name, c.audience, r.status,o.organisation_id ) ORDER BY c.name",
            "parameters": [
                {
                    "index": 0,
                    "name": "start_date",
                    "filterType": "date",
                    "reportFieldType": "date",
                    "display": "Enter Start Date",
                    "mandatory": "true"
                },
                {
                    "index": 1,
                    "name": "end_date",
                    "filterType": "date",
                    "reportFieldType": "date",
                    "display": "Enter End Date",
                    "mandatory": "true"
                }
            ],
            "schema": {
                "field": [
                    {
                        "name": "course_name",
                        "type": "string",
                        "display": "Name"
                    },
                    {
                        "name": "audience",
                        "type": "string",
                        "display": "Audience",
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "Sexual offence",
                                    "display": "Sexual offence"
                                },
                                {
                                    "name": "General violence offence",
                                    "display": "General violence offence"
                                }
                            ]
                        }
                    },
                    {
                        "name": "status",
                        "type": "int",
                        "display": "Status",
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "DESELECTED",
                                    "display": "DESELECTED"
                                },
                                {
                                    "name": "WITHDRAWN",
                                    "display": "WITHDRAWN"
                                },
                                {
                                    "name": "REFERRAL_STARTED",
                                    "display": "REFERRAL_STARTED"
                                }
                            ]
                        }
                    },
                    {
                        "name": "organisation_id",
                        "type": "string",
                        "display": "Org",
                        "filter": {
                            "type": "multiselect",
                            "interactive": true,
                            "dynamicoptions": {
                                "returnAsStaticOptions": true,
                                "maximumOptions": 130,
                                "dataset": "$ref:prisons",
                                "name": "code",
                                "display": "name"
                            }
                        }
                    },
                    {
                        "name": "referral_count",
                        "type": "string",
                        "display": "Count"
                    }
                ]
            }
        },
        {
            "id": "courses",
            "name": "courses",
            "datasource": "athena_apc",
            "query": "SELECT name FROM public.course WHERE withdrawn = false",
            "schema": {
                "field": [
                    {
                        "name": "name",
                        "type": "string",
                        "display": ""
                    }
                ]
            }
        },
        {
            "id": "prisons",
            "name": "prisons",
            "datasource": "datamart",
            "query": "SELECT p.prison_id as code,name, region FROM establishment.prison p WHERE active = TRUE ORDER by name",
            "schema": {
                "field": [
                    {
                        "name": "code",
                        "type": "string"
                    },
                    {
                        "name": "name",
                        "type": "string"
                    },
                    {
                        "name": "region",
                        "type": "string"
                    }
                ]
            }
        },
        {
            "id": "regions",
            "name": "regions",
            "datasource": "datamart",
            "query": "select DISTINCT region from establishment.prison order by region",
            "schema": {
                "field": [
                    {
                        "name": "region",
                        "type": "string"
                    }
                ]
            }
        },
        {
            "id": "individual-referrals",
            "name": "individuals",
            "datasource": "athena_apc",
            "query": [
                {
                    "index": 0,
                    "datasource": "athena_redshift",
                    "query": "SELECT p.prison_id as code,name AS establishment_name, region FROM establishment.prison p WHERE active = TRUE ORDER by name"
                },
                {
                    "index": 1,
                    "datasource": "athena_apc",
                    "query": "SELECT r.prison_number, gender, location, earliest_release_date, earliest_release_date_type, CASE WHEN earliest_release_date - current_date > 180 THEN 'No' WHEN earliest_release_date - current_date > 0 THEN 'Yes' ELSE 'N/A' END AS earliest_release_date_indicator, sentence_type, r.status, referral_id, r.submitted_on, r.additional_information, c.name AS course_name, c.course_id, rs.closed FROM public.referral r LEFT JOIN person p ON p.prison_number = r.prison_number LEFT JOIN offering o ON o.offering_id = r.offering_id LEFT JOIN course c ON c.course_id = o.course_id LEFT JOIN referral_status rs ON rs.code = r.status "
                },
                {
                    "index": 2,
                    "datasource": "athena",
                    "query": "SELECT prison_number, gender, location, earliest_release_date, earliest_release_date_type, earliest_release_date_indicator, sentence_type, status, referral_id, submitted_on, additional_information, name, course_id, closed,region from AwsDataCatalog.reports.${table[1]} JOIN AwsDataCatalog.reports.${table[0]} on AwsDataCatalog.reports.${table[1]}.LOCATION=AwsDataCatalog.reports.${table[0]}.establishment_name"
                }
            ],
            "schema": {
                "field": [
                    {
                        "name": "prison_number",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "gender",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "location",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "earliest_release_date",
                        "type": "date",
                        "display": ""
                    },
                    {
                        "name": "earliest_release_date_type",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "earliest_release_date_indicator",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "sentence_type",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "status",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "referral_id",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "submitted_on",
                        "type": "date",
                        "display": ""
                    },
                    {
                        "name": "additional_information",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "course_name",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "course_id",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "closed",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "region",
                        "type": "string",
                        "display": ""
                    }
                ]
            }
        }
    ],
    "policy": [
        {
            "id": "access",
            "type": "access",
            "rule": [
                {
                    "effect": "permit",
                    "condition": [
                        {
                            "match": [
                                "${role}",
                                "BCMI_REPORTS_VIEWER"
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "report": [
        {
            "id": "referrals-by-individual",
            "name": "Table of all referrals",
            "description": "A table for all referrals, with the ability to subsequently sort and filter the data by any of the fields.",
            "classification": "Official",
            "version": "1.0.0",
            "render": "HTML",
            "dataset": "$ref:individual-referrals",
            "feature": [
                {
                    "type": "print"
                }
            ],
            "metadata": {
                "hints": [
                    "interactive"
                ]
            },
            "specification": {
                "template": "list",
                "field": [
                    {
                        "name": "$ref:prison_number",
                        "display": "Prison Number",
                        "formula": "make_url('https://digital.prison.service.justice.gov.uk/prisoner/${prison_number}/',${prison_number},TRUE)",
                        "visible": "true",
                        "sortable": "true",
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:gender",
                        "display": "Gender",
                        "formula": "",
                        "visible": "true",
                        "sortable": "true",
                        "defaultsort": false,
                        "filter": {
                            "index": 0,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "Male",
                                    "display": "Male"
                                },
                                {
                                    "name": "Female",
                                    "display": "Female"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:sentence_type",
                        "display": "Sentence type",
                        "formula": "",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false,
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "Determinate",
                                    "display": "Determinate"
                                },
                                {
                                    "name": "Determinate and Recall",
                                    "display": "Determinate and Recall"
                                },
                                {
                                    "name": "Indeterminate",
                                    "display": "Indeterminate"
                                },
                                {
                                    "name": "Indeterminate and Recall",
                                    "display": "Indeterminate and Recall"
                                },
                                {
                                    "name": "No active sentences",
                                    "display": "No active sentences"
                                },
                                {
                                    "name": "Recall",
                                    "display": "Recall"
                                },
                                {
                                    "name": "Unknown",
                                    "display": "Unknown"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:location",
                        "display": "Location",
                        "visible": "true",
                        "sortable": "true",
                        "defaultsort": false,
                        "filter": {
                            "type": "multiselect",
                            "interactive": true,
                            "dynamicoptions": {
                                "returnAsStaticOptions": true,
                                "maximumOptions": 130,
                                "dataset": "$ref:prisons",
                                "name": "name",
                                "display": "name"
                            }
                        }
                    },
                    {
                        "name": "$ref:earliest_release_date",
                        "display": "Earliest release date",
                        "formula": "format_date(${earliest_release_date}, 'dd MMMM yyyy')",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false,
                        "filter": {
                            "index": 0,
                            "interactive": "true",
                            "type": "daterange",
                            "default": ""
                        }
                    },
                    {
                        "name": "$ref:earliest_release_date_type",
                        "display": "Release date type",
                        "formula": "",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:earliest_release_date_indicator",
                        "display": "Earliest release date indicator",
                        "formula": "",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false,
                        "filter": {
                            "index": 5,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "Yes",
                                    "display": "Yes"
                                },
                                {
                                    "name": "No",
                                    "display": "No"
                                },
                                {
                                    "name": "N/A",
                                    "display": "N/A"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:course_id",
                        "display": "Course Name",
                        "formula": "${course_name}",
                        "visible": "true",
                        "sortable": "true",
                        "defaultsort": false,
                        "filter": {
                            "type": "multiselect",
                            "interactive": true,
                            "dynamicoptions": {
                                "returnAsStaticOptions": true,
                                "maximumOptions": 130,
                                "dataset": "$ref:courses",
                                "name": "name",
                                "display": "name"
                            }
                        }
                    },
                    {
                        "name": "$ref:referral_id",
                        "display": "Referral ID",
                        "formula": "",
                        "visible": "false",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:submitted_on",
                        "display": "Submitted on",
                        "formula": "format_date(${submitted_on}, 'dd MMMM yyyy')",
                        "visible": "true",
                        "sortable": "true",
                        "defaultsort": "true",
                        "filter": {
                            "index": 3,
                            "interactive": "true",
                            "type": "daterange",
                            "default": ""
                        }
                    },
                    {
                        "name": "$ref:status",
                        "display": "Status",
                        "formula": "",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false,
                        "filter": {
                            "index": 2,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "ASSESSED_SUITABLE",
                                    "display": "ASSESSED_SUITABLE"
                                },
                                {
                                    "name": "ASSESSMENT_STARTED",
                                    "display": "ASSESSMENT_STARTED"
                                },
                                {
                                    "name": "AWAITING_ASSESSMENT",
                                    "display": "AWAITING_ASSESSMENT"
                                },
                                {
                                    "name": "DESELECTED",
                                    "display": "DESELECTED"
                                },
                                {
                                    "name": "MOVED_TO_BUILDING_CHOICES",
                                    "display": "MOVED_TO_BUILDING_CHOICES"
                                },
                                {
                                    "name": "NOT_ELIGIBLE",
                                    "display": "NOT_ELIGIBLE"
                                },
                                {
                                    "name": "NOT_SUITABLE",
                                    "display": "NOT_SUITABLE"
                                },
                                {
                                    "name": "ON_HOLD_ASSESSMENT_STARTED",
                                    "display": "ON_HOLD_ASSESSMENT_STARTED"
                                },
                                {
                                    "name": "ON_HOLD_AWAITING_ASSESSMENT",
                                    "display": "ON_HOLD_AWAITING_ASSESSMENT"
                                },
                                {
                                    "name": "ON_HOLD_REFERRAL_SUBMITTED",
                                    "display": "ON_HOLD_REFERRAL_SUBMITTED"
                                },
                                {
                                    "name": "ON_PROGRAMME",
                                    "display": "ON_PROGRAMME"
                                },
                                {
                                    "name": "PROGRAMME_COMPLETE",
                                    "display": "PROGRAMME_COMPLETE"
                                },
                                {
                                    "name": "REFERRAL_STARTED",
                                    "display": "REFERRAL_STARTED"
                                },
                                {
                                    "name": "REFERRAL_SUBMITTED",
                                    "display": "REFERRAL_SUBMITTED"
                                },
                                {
                                    "name": "SUITABLE_NOT_READY",
                                    "display": "SUITABLE_NOT_READY"
                                },
                                {
                                    "name": "WITHDRAWN",
                                    "display": "WITHDRAWN"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:closed",
                        "display": "Closed",
                        "formula": "",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false,
                        "filter": {
                            "index": 0,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "true",
                                    "display": "Closed"
                                },
                                {
                                    "name": "false",
                                    "display": "Open"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:additional_information",
                        "display": "Info",
                        "formula": "",
                        "visible": "false",
                        "sortable": false,
                        "defaultsort": false
                    }
                ]
            }
        }
    ],
