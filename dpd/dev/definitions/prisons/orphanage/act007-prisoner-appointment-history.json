{
  "id": "act007-prisoner-appointment-history",
  "name": "Prisoner appointments",
  "description": "Historic and future appointments for an individual prisoner over a selected date range. Use a seven-day period for the initial view.",
  "metadata": {
    "author": "Martin Lippe",
    "owner": "Claire Morgan",
    "version": "0.1.4"
  },
  "datasource": [
    {
      "id": "athena",
      "name": "athena",
      "database": "curated",
      "catalog": "awsdatacatalog",
      "connection": "awsdatacatalog",
      "dialect": "athena/3"
    }
  ],
  "dataset": [
    {
      "id": "prisoner-appointments",
      "name": "Appointments for an individual prisoner",
      "datasource": "athena",
      "query": [
        {
          "index": 0,
          "datasource": "athena",
          "query": "WITH person_prisoner AS (\n  SELECT\n    o.offender_id_display AS prisoner_number,\n    REGEXP_REPLACE(LOWER(o.last_name || ', ' || o.first_name), '(\\b[a-z])', x -> UPPER(x[1])) AS prisoner_name,\n    ob.agy_loc_id AS current_prison_id\n  FROM curated.nomis_offender_bookings ob\n  INNER JOIN curated.nomis_offenders o\n    ON ob.offender_id = o.offender_id\n   AND ob.booking_seq = 1\n)\nSELECT\n  app.prison_code,\n  att.prisoner_number,\n  dm.prisoner_name,\n  app.appointment_id,\n  app.appointment_tier_id AS appointment_tier,\n  app.start_date,\n  SUBSTRING(app.start_time, 1, 5) AS start_time,\n  SUBSTRING(app.end_time, 1, 5) AS end_time,\n  COALESCE(SUBSTRING(app.start_time, 1, 5), '') ||\n    CASE\n      WHEN app.end_time IS NOT NULL THEN ' - ' || SUBSTRING(app.end_time, 1, 5)\n      ELSE ''\n    END AS start_to_end,\n  par.name AS parent_category,\n  cat.description AS appointment_category,\n  app.category_code,\n  app.custom_name AS custom_appointment_name,\n  COALESCE(\n    NULLIF(app.custom_location, ''),\n    dps_loc.local_name,\n    nomis_loc.description,\n    dps_loc.path_hierarchy,\n    'Not recorded'\n  ) AS appointment_location,\n  CASE\n    WHEN app.cancellation_reason_id IS NOT NULL THEN 'Cancelled'\n    WHEN att.removal_reason_id IS NOT NULL OR att.is_deleted THEN 'Removed'\n    WHEN app.start_date > CURRENT_DATE\n      OR (\n        app.start_date = CURRENT_DATE\n        AND COALESCE(SUBSTRING(app.start_time, 1, 5), '23:59') > FORMAT_DATETIME(CURRENT_TIMESTAMP AT TIME ZONE 'Europe/London', 'HH:mm')\n      ) THEN 'Scheduled'\n    WHEN att.attended IS NULL THEN 'Not recorded'\n    WHEN att.attended = FALSE THEN 'Did not attend'\n    WHEN att.attended = TRUE THEN 'Attended'\n  END AS appointment_status,\n  cancellation_reason.description AS cancellation_reason,\n  removal_reason.description AS removal_reason,\n  'Open appointment' AS appointment_link\nFROM curated.activities_appointment_attendee att\nINNER JOIN curated.activities_appointment app\n  ON app.appointment_id = att.appointment_id\nINNER JOIN person_prisoner dm\n  ON dm.prisoner_number = att.prisoner_number\nLEFT JOIN curated.activities_appointment_category cat\n  ON cat.code = app.category_code\nLEFT JOIN curated.activities_appointment_parent_category par\n  ON par.appointment_parent_category_id = cat.appointment_parent_category_id\nLEFT JOIN curated.activities_appointment_cancellation_reason cancellation_reason\n  ON cancellation_reason.appointment_cancellation_reason_id = app.cancellation_reason_id\nLEFT JOIN curated.activities_appointment_attendee_removal_reason removal_reason\n  ON removal_reason.appointment_attendee_removal_reason_id = att.removal_reason_id\nLEFT JOIN curated.nomis_agency_internal_locations nomis_loc\n  ON nomis_loc.internal_location_id = app.internal_location_id\nLEFT JOIN curated.locationsinsideprison_location dps_loc\n  ON dps_loc.id = app.dps_location_id\nWHERE att.prisoner_number = UPPER((SELECT prisoner_number_filter FROM prompt_))\n  AND app.start_date >= (SELECT from_date FROM prompt_)\n  AND app.start_date < (SELECT to_date FROM prompt_) + INTERVAL '1' DAY\n  AND app.appointment_tier_id IN (1, 2)\n  AND NOT app.is_deleted\n  AND app.start_date BETWEEN DATE_ADD('month', -12, CURRENT_DATE) AND DATE_ADD('day', 370, CURRENT_DATE)\nORDER BY app.start_date, app.start_time, app.appointment_id"
        }
      ],
      "parameters": [
        {
          "index": 0,
          "name": "prisoner_number_filter",
          "filterType": "text",
          "reportFieldType": "string",
          "display": "Prisoner number",
          "description": "Prisoner number used to constrain the initial Athena query",
          "mandatory": "true"
        },
        {
          "index": 1,
          "name": "from_date",
          "filterType": "date",
          "reportFieldType": "date",
          "display": "From date",
          "description": "First appointment date to include. The earliest supported date is 12 months before today; use a seven-day period for the initial view.",
          "mandatory": "true"
        },
        {
          "index": 2,
          "name": "to_date",
          "filterType": "date",
          "reportFieldType": "date",
          "display": "To date",
          "description": "Last appointment date to include. The latest supported date is 370 days after today.",
          "mandatory": "true"
        }
      ],
