{
  "id": "contacts-prisoners-without-emergency-contact-001",
  "name": "Prisoners without an emergency contact or next of kin",
  "description": "Prisoners currently in custody at the selected prison with no active, unexpired emergency contact or next of kin recorded in personal relationships",
  "metadata": {
    "author": "Kristian Gregor",
    "owner": "Prisoner Contacts and Personal Relationships",
    "version": "1.0.0"
  },
  "datasource": [
    {
      "id": "datamart",
      "name": "datamart"
    }
  ],
  "dataset": [
    {
      "id": "prisoners-without-emergency-contact",
      "name": "Prisoners without an active emergency contact",
      "datasource": "datamart",
      "query": "SELECT ob.agy_loc_id AS prison_code, o.offender_id_display AS prisoner_number, o.last_name AS last_name, o.first_name AS first_name, ob.living_unit_id AS living_unit_id, 'Manage contacts' AS contacts_link FROM prisons.nomis_offender_bookings ob JOIN prisons.nomis_offenders o ON o.offender_id = ob.offender_id LEFT JOIN (SELECT DISTINCT prisoner_number FROM prisons.personalrelationships_prisoner_contact WHERE active AND (emergency_contact OR next_of_kin) AND (expiry_date IS NULL OR expiry_date >= CURRENT_DATE)) ec ON ec.prisoner_number = o.offender_id_display WHERE ob.active_flag = 'Y' AND ob.in_out_status = 'IN' AND ec.prisoner_number IS NULL",
      "schema": {
        "field": [
          {
            "name": "prison_code",
            "type": "string",
            "display": "Prison"
          },
          {
            "name": "prisoner_number",
            "type": "string",
            "display": "Prison Number"
          },
          {
            "name": "last_name",
            "type": "string",
            "display": "Last Name"
          },
          {
            "name": "first_name",
            "type": "string",
            "display": "First Name"
          },
          {
            "name": "living_unit_id",
            "type": "string",
            "display": "Cell"
          },
          {
            "name": "contacts_link",
            "type": "string",
            "display": "Contacts"
          }
        ]
      }
    },
    {
      "id": "prison-code-filter",
      "name": "Prison Code Filter",
      "datasource": "datamart",
      "query": "SELECT DISTINCT agy_loc_id AS prison_code FROM prisons.nomis_offender_bookings WHERE active_flag = 'Y' AND in_out_status = 'IN'",
      "schema": {
        "field": [
          {
            "name": "prison_code",
            "type": "string",
            "display": "Prison"
          }
        ]
      }
    }
  ],
  "policy": [
    {
      "id": "access",
      "type": "access",
      "rule": [
        {
          "effect": "permit",
          "condition": [
            {
              "match": [
                "${role}",
                "ROLE_PRISONS_REPORTING_USER"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "caseload",
      "type": "row-level",
      "action": [
        "(prison_code='${caseload}')"
      ],
      "rule": [
        {
          "effect": "permit",
          "condition": [
            {
              "exists": [
                "${caseload}"
              ]
            }
          ]
        }
      ]
    }
  ],
  "report": [
    {
      "id": "prisoners-without-emergency-contact-report",
      "name": "Prisoners without an emergency contact or next of kin",
      "description": "Prisoners currently in custody at the selected prison with no active, unexpired emergency contact or next of kin recorded in personal relationships",
      "classification": "Official",
      "version": "1.0.0",
      "render": "HTML",
      "dataset": "$ref:prisoners-without-emergency-contact",
      "feature": [
        {
          "type": "print"
        }
      ],
      "specification": {
        "template": "list",
        "field": [
          {
            "name": "$ref:prison_code",
            "display": "Prison",
            "formula": "",
            "visible": "true",
            "sortable": true,
            "defaultsort": false,
            "filter": {
              "type": "select",
              "dynamicoptions": {
                "returnAsStaticOptions": true,
                "maximumOptions": 200,
                "dataset": "$ref:prison-code-filter",
                "name": "prison_code",
                "display": "prison_code"
              }
            }
          },
          {
            "name": "$ref:prisoner_number",
            "display": "Prison Number",
            "formula": "",
            "visible": "true",
            "sortable": true,
            "defaultsort": false
          },
          {
            "name": "$ref:last_name",
            "display": "Last Name",
            "formula": "make_url('https://prisoner-${env}.digital.prison.service.justice.gov.uk/prisoner/${prisoner_number}',${last_name},TRUE)",
            "visible": "true",
            "sortable": true,
            "defaultsort": true
          },
          {
            "name": "$ref:first_name",
            "display": "First Name",
            "formula": "",
            "visible": "true",
            "sortable": true,
            "defaultsort": false
          },
          {
            "name": "$ref:living_unit_id",
            "display": "Cell",
            "formula": "",
            "visible": "true",
            "sortable": true,
            "defaultsort": false
          },
          {
            "name": "$ref:contacts_link",
            "display": "Contacts",
            "formula": "make_url('https://contacts-dev.hmpps.service.justice.gov.uk/prisoner/${prisoner_number}/contacts/list',${contacts_link},TRUE)",
            "visible": "true",
            "sortable": false,
            "defaultsort": false
          }
        ]
      }
    }
  ]
}
