    "dataset": [
        {
            "id": "san-dataset",
            "name": "Applications",
            "datasource": "datamart",
            "query": "SELECT prison_number, CAST(age AS VARCHAR) AS age, sex_code, ethnicity_code, ethnicity, cell_location, current_location, UPPER(has_need) AS has_need, UPPER(has_aln_need) AS has_aln_need, UPPER(has_ldd_need) AS has_ldd_need, CASE WHEN conditions_restricting_mobility_dexterity IS TRUE THEN 'TRUE' WHEN conditions_restricting_mobility_dexterity IS FALSE THEN 'FALSE' ELSE NULL END AS conditions_restricting_mobility_dexterity, CASE WHEN other_language_speech_communication_disorder IS TRUE THEN 'TRUE' WHEN other_language_speech_communication_disorder IS FALSE THEN 'FALSE' ELSE NULL END AS other_language_speech_communication_disorder, CASE WHEN dyspraxia_developmental_coordination_disorder IS TRUE THEN 'TRUE' WHEN dyspraxia_developmental_coordination_disorder IS FALSE THEN 'FALSE' ELSE NULL END AS dyspraxia_developmental_coordination_disorder, CASE WHEN acquired_brain_injury IS TRUE THEN 'TRUE' WHEN acquired_brain_injury IS FALSE THEN 'FALSE' ELSE NULL END AS acquired_brain_injury, CASE WHEN dyslexia IS TRUE THEN 'TRUE' WHEN dyslexia IS FALSE THEN 'FALSE' ELSE NULL END AS dyslexia, CASE WHEN autism_spectrum_condition IS TRUE THEN 'TRUE' WHEN autism_spectrum_condition IS FALSE THEN 'FALSE' ELSE NULL END AS autism_spectrum_condition, CASE WHEN attention_deficit_hyperactivity_disorder_adhd_add IS TRUE THEN 'TRUE' WHEN attention_deficit_hyperactivity_disorder_adhd_add IS FALSE THEN 'FALSE' ELSE NULL END AS attention_deficit_hyperactivity_disorder_adhd_add, CASE WHEN dyscalculia IS TRUE THEN 'TRUE' WHEN dyscalculia IS FALSE THEN 'FALSE' ELSE NULL END AS dyscalculia, CASE WHEN other_learning_disability IS TRUE THEN 'TRUE' WHEN other_learning_disability IS FALSE THEN 'FALSE' ELSE NULL END AS other_learning_disability, CASE WHEN mental_health IS TRUE THEN 'TRUE' WHEN mental_health IS FALSE THEN 'FALSE' ELSE NULL END AS mental_health, CASE WHEN visual_impairment IS TRUE THEN 'TRUE' WHEN visual_impairment IS FALSE THEN 'FALSE' ELSE NULL END AS visual_impairment, CASE WHEN other_disability_or_health_condition_not_listed_above IS TRUE THEN 'TRUE' WHEN other_disability_or_health_condition_not_listed_above IS FALSE THEN 'FALSE' ELSE NULL END AS other_disability_or_health_condition_not_listed_above, CASE WHEN other IS TRUE THEN 'TRUE' WHEN other IS FALSE THEN 'FALSE' ELSE NULL END AS other, CASE WHEN downs_syndrome IS TRUE THEN 'TRUE' WHEN downs_syndrome IS FALSE THEN 'FALSE' ELSE NULL END AS downs_syndrome, CASE WHEN developmental_language_disorder IS TRUE THEN 'TRUE' WHEN developmental_language_disorder IS FALSE THEN 'FALSE' ELSE NULL END AS developmental_language_disorder, CASE WHEN neurodegenerative_condition IS TRUE THEN 'TRUE' WHEN neurodegenerative_condition IS FALSE THEN 'FALSE' ELSE NULL END AS neurodegenerative_condition, CASE WHEN foetal_alcohol_spectrum_disorder IS TRUE THEN 'TRUE' WHEN foetal_alcohol_spectrum_disorder IS FALSE THEN 'FALSE' ELSE NULL END AS foetal_alcohol_spectrum_disorder, CASE WHEN hearing_impairment IS TRUE THEN 'TRUE' WHEN hearing_impairment IS FALSE THEN 'FALSE' ELSE NULL END AS hearing_impairment, CASE WHEN tourettes_syndrome_tic_disorder IS TRUE THEN 'TRUE' WHEN tourettes_syndrome_tic_disorder IS FALSE THEN 'FALSE' ELSE NULL END AS tourettes_syndrome_tic_disorder, CASE WHEN other_long_term_medical_condition IS TRUE THEN 'TRUE' WHEN other_long_term_medical_condition IS FALSE THEN 'FALSE' ELSE NULL END AS other_long_term_medical_condition, CASE WHEN other_neurological_condition IS TRUE THEN 'TRUE' WHEN other_neurological_condition IS FALSE THEN 'FALSE' ELSE NULL END AS other_neurological_condition, CASE WHEN challenge_physical_skills IS TRUE THEN 'TRUE' WHEN challenge_physical_skills IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_physical_skills, CASE WHEN challenge_attention_organising_time IS TRUE THEN 'TRUE' WHEN challenge_attention_organising_time IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_attention_organising_time, CASE WHEN challenge_processing_speed IS TRUE THEN 'TRUE' WHEN challenge_processing_speed IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_processing_speed, CASE WHEN challenge_numeracy_skills IS TRUE THEN 'TRUE' WHEN challenge_numeracy_skills IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_numeracy_skills, CASE WHEN challenge_sensory IS TRUE THEN 'TRUE' WHEN challenge_sensory IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_sensory, CASE WHEN challenge_language_comm_skills IS TRUE THEN 'TRUE' WHEN challenge_language_comm_skills IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_language_comm_skills, CASE WHEN challenge_emotions_feelings IS TRUE THEN 'TRUE' WHEN challenge_emotions_feelings IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_emotions_feelings, CASE WHEN challenge_literacy_skills IS TRUE THEN 'TRUE' WHEN challenge_literacy_skills IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_literacy_skills, CASE WHEN challenge_memory IS TRUE THEN 'TRUE' WHEN challenge_memory IS FALSE THEN 'FALSE' ELSE NULL END AS challenge_memory FROM prison_domains.supportforadditionalneeds_prisoner_challenges_and_conditions",
