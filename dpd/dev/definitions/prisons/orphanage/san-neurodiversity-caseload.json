    "policy": [
        {
            "id": "access",
            "type": "access",
            "rule": [
                {
                    "effect": "permit",
                    "condition": [
                        {
                            "match": [
                                "${role}",
                                "ROLE_SAN_EDITOR",
                                "ROLE_SAN_EDUCATION_MANAGER"
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "caseload",
            "type": "row-level",
            "action": [
                "(current_location='${caseload}')"
            ],
            "rule": [
                {
                    "effect": "permit",
                    "condition": [
                        {
                            "exists": [
                                "${caseload}"
                            ]
                        }
                    ]
                }
            ]
        }
    ],
