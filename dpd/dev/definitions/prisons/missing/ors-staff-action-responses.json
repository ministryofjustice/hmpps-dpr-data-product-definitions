{
  "id": "FiVYYwEPFAcAAhQEAAC3vS0AACJIAGc1",
  "name": "ORS Staff Action Responses",
  "description": "This report summarises and details the account responses made by Central Administration for a date range (as seen in Prison-NOMIS screen 'Central Administration of New Staff Requests OUDCASAR.)<br/>UAR0008 v1 Last Modified:24/07/2023",
  "metadata": {
    "version": "1.0.0",
    "tags": [
      "UAR0008 v1"
    ],
    "author": "",
    "owner": ""
  },
  "datasource": [
    {
      "id": "nomis",
      "name": "NOMIS",
      "database": "DIGITAL_PRISON_REPORTING",
      "catalog": "nomis"
    }
  ],
  "dataset": [
    {
      "id": "3376701/DP0",
      "name": "Responses",
      "description": "OR - Users and Roles",
      "datasource": "nomis",
      "query": "dataset_base_ AS (SELECT AT_STAFF_ACTION_REQUESTS.ACTION_REQUEST_TYPE, AT_STAFF_ACTION_REQUESTS.STAFF_ACTION_REQUEST_ID, AT_STAFF_ACTION_REQUESTS.RESPONSE_DATETIME, AT_STAFF_ACTION_REQUESTS.ACTION_REQUEST_SUB_STATUS FROM OMS_OWNER.STAFF_ACTION_REQUESTS AT_STAFF_ACTION_REQUESTS WHERE (AT_STAFF_ACTION_REQUESTS.RESPONSE_DATETIME BETWEEN TO_DATE('17-07-2023 00:00:00', 'DD-MM-YYYY HH24:MI:SS') AND TO_DATE('24-07-2023 00:00:00', 'DD-MM-YYYY HH24:MI:SS') AND AT_STAFF_ACTION_REQUESTS.ACTION_REQUEST_TYPE <> 'TRANSFER')), dataset_ AS (SELECT ACTION_REQUEST_TYPE, STAFF_ACTION_REQUEST_ID, RESPONSE_DATETIME, ACTION_REQUEST_SUB_STATUS, MONTH(TO_DATE(RESPONSE_DATETIME, 'DD-MM-YYYY HH24:MI:SS')) AS V_MONTH FROM dataset_base_)",
      "parameters": [],
      "schema": {
        "field": [
          {
            "name": "ACTION_REQUEST_TYPE",
            "type": "string",
            "display": "Action Request Type"
          },
          {
            "name": "STAFF_ACTION_REQUEST_ID",
            "type": "double",
            "display": "Staff Action Request Id"
          },
          {
            "name": "RESPONSE_DATETIME",
            "type": "date",
            "display": "Response Datetime"
          },
          {
            "name": "ACTION_REQUEST_SUB_STATUS",
            "type": "string",
            "display": "Action Request Sub Status"
          },
          {
            "name": "V_MONTH",
            "type": "string",
            "display": "V_MONTH"
          }
        ]
      }
    }
  ],
  "policy": [
    {
      "id": "access",
      "type": "access",
      "rule": [
        {
          "effect": "permit",
          "condition": [
            {
              "match": [
                "${role}",
                "ROLE_PRISONS_REPORTING_USER"
              ]
            }
          ]
        }
      ]
    }
  ],
  "report": [
    {
      "id": "172152.RS",
      "name": "Summary of Responses",
      "classification": "OFFICIAL",
      "version": "1.0.0",
      "render": "HTML",
      "dataset": "3376701/DP0",
      "feature": [
        {
          "type": "print"
        }
      ],
      "specification": {
        "template": "list",
        "field": [
          {
            "name": "$ref:V_MONTH",
            "display": "=Sum(Count([Staff Action Request Id]))",
            "formula": "",
            "visible": "true",
            "sortable": false,
            "defaultsort": false
          },
          {
            "name": "$ref:ACTION_REQUEST_TYPE",
            "display": "Action Request Type",
            "formula": "",
            "visible": "true",
            "sortable": true,
            "defaultsort": false
          },
          {
            "name": "$ref:ACTION_REQUEST_SUB_STATUS",
            "display": "Action Request Sub Status",
            "formula": "",
            "visible": "true",
            "sortable": true,
            "defaultsort": false
          }
        ]
      }
    }
  ],
  "schemaversion": "1.1.0"
}
