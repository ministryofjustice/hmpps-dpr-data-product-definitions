      "id": "3376639/DP0",
      "name": "Activities",
      "description": "MIS - Demographics",
      "datasource": "bodmis",
      "query": "dataset_base_ AS (SELECT AT_ACTIVITY_ESTABLISHMENT.ESTABLISHMENT_CODE_NK, AT_ACTIVITY_ESTABLISHMENT.ESTABLISHMENT_DESCRIPTION, AT_DIM_PROGRAMME_SERVICE.DESCRIPTION, AT_DIM_PROGRAMME_TYPE.DESCRIPTION AS ACTIVITY_DESCRIPTION, TRUNC(AT_FACT_OFFENDER_ACTIVITY.START_TIME) AS ACTIVITY_SESSION_DATE, AT_FACT_OFFENDER_ACTIVITY.STATUS, AT_FACT_OFFENDER_ACTIVITY.START_TIME, AT_FACT_OFFENDER_ACTIVITY.END_TIME, ((AT_FACT_OFFENDER_ACTIVITY.END_TIME - AT_FACT_OFFENDER_ACTIVITY.START_TIME) * 24 * 60 * 60) / 60 / 60 AS ACTIVITY_SESSION_DURATION, COALESCE(AT_FACT_OFFENDER_ACTIVITY.SLOT_CATEGORY_CODE, 'No Slot') AS SLOT_AS_DIMENSION, AT_OFFENDER_BOOKING.OFFENDER_ID_DISPLAY, AT_FACT_OFFENDER_ACTIVITY.ALLOCATED_FLAG, AT_DIM_LOCATION.UNIT_4_SHORT_DESCRIPTION, AT_OFFENDER_BOOKING.SURNAME, AT_FACT_OFFENDER_ACTIVITY.COMMENT_TEXT, AT_DIM_PROGRAMME_SERVICE.CODE, AT_DIM_SERVICE_CATEGORY.CODE AS ACTIVITY_SERVICE_CATEGORY_CODE, COUNT(DISTINCT (AT_OFFENDER_BOOKING.OFFENDER_ID_DISPLAY)) AS COUNT_OF_OFFENDERS, AT_DIM_PROGRAMME_TYPE.CODE AS ACTIVITY_CODE, AT_DIM_ACTIVITY_STATUS.DESCRIPTION AS ACTIVITY_SESSION_STATUS_DESC35, AT_CELL.UNIT_1_CODE FROM BODIMIS.FACT_OFFENDER_ACTIVITY AT_FACT_OFFENDER_ACTIVITY, BODIMIS.DIM_CELL AT_DIM_LOCATION, BODIMIS.DIM_ESTABLISHMENT AT_ACTIVITY_ESTABLISHMENT, BODIMIS.DIM_PROGRAMME_SERVICE AT_DIM_PROGRAMME_SERVICE, BODIMIS.DIM_PROGRAMME_TYPE AT_DIM_PROGRAMME_TYPE, BODIMIS.DIM_OFFENDER_BOOKING AT_OFFENDER_BOOKING, BODIMIS.DIM_REFERENCE_CODES AT_DIM_SERVICE_CATEGORY, BODIMIS.DIM_REFERENCE_CODES AT_DIM_ACTIVITY_STATUS, BODIMIS.DIM_CELL AT_CELL WHERE (AT_CELL.UNIT_4_SK = AT_OFFENDER_BOOKING.LIVING_UNIT_SK) AND (AT_OFFENDER_BOOKING.OFFENDER_BOOKING_SK IN (SELECT CSL.OFFENDER_BOOKING_SK FROM BODIMIS.DIM_STAFF_ACCESSIBLE_CASELOAD SAC, BODIMIS.DIM_CASELOAD_SECURITY_LIST CSL WHERE SAC.CASELOAD_ID = CSL.CASELOAD_CODE AND SAC.USERNAME = (SELECT username FROM context_) AND CSL.ENDYEAR >= TO_CHAR(CURRENT_TIMESTAMP, 'YYYY') - 6)) AND (AT_OFFENDER_BOOKING.OFFENDER_BOOKING_SK = AT_FACT_OFFENDER_ACTIVITY.OFFENDER_BOOKING_SK) AND (AT_DIM_PROGRAMME_TYPE.PROGRAMME_TYPE_SK = AT_FACT_OFFENDER_ACTIVITY.PROGRAMME_TYPE_SK) AND (AT_DIM_ACTIVITY_STATUS.CODE_DOMAIN (+) = 'PS_PA_OC') AND (AT_DIM_ACTIVITY_STATUS.CODE (+) = AT_FACT_OFFENDER_ACTIVITY.STATUS) AND (AT_ACTIVITY_ESTABLISHMENT.ESTABLISHMENT_SK = AT_FACT_OFFENDER_ACTIVITY.ESTABLISHMENT_SK) AND (AT_DIM_PROGRAMME_SERVICE.PROGRAMME_SERVICE_SK = AT_FACT_OFFENDER_ACTIVITY.PROGRAMME_SERVICE_SK) AND (AT_DIM_SERVICE_CATEGORY.CODE_DOMAIN (+) = 'PS_CATEGORY') AND (AT_DIM_SERVICE_CATEGORY.CODE = AT_DIM_PROGRAMME_SERVICE.PROGRAM_CATEGORY) AND (AT_OFFENDER_BOOKING.LIVING_UNIT_SK = AT_DIM_LOCATION.UNIT_4_SK (+)) AND (AT_ACTIVITY_ESTABLISHMENT.ESTABLISHMENT_CODE_NK = (SELECT establishment_code FROM prompt_) AND TRUNC(AT_FACT_OFFENDER_ACTIVITY.START_TIME) BETWEEN TO_DATE('07-11-2021 00:00:00', 'DD-MM-YYYY HH24:MI:SS') AND TO_DATE('11-11-2021 00:00:00', 'DD-MM-YYYY HH24:MI:SS') AND AT_FACT_OFFENDER_ACTIVITY.ALLOCATED_FLAG = 'Y') GROUP BY AT_ACTIVITY_ESTABLISHMENT.ESTABLISHMENT_CODE_NK, AT_ACTIVITY_ESTABLISHMENT.ESTABLISHMENT_DESCRIPTION, AT_DIM_PROGRAMME_SERVICE.DESCRIPTION, AT_DIM_PROGRAMME_TYPE.DESCRIPTION, TRUNC(AT_FACT_OFFENDER_ACTIVITY.START_TIME), AT_FACT_OFFENDER_ACTIVITY.STATUS, AT_FACT_OFFENDER_ACTIVITY.START_TIME, AT_FACT_OFFENDER_ACTIVITY.END_TIME, ((AT_FACT_OFFENDER_ACTIVITY.END_TIME - AT_FACT_OFFENDER_ACTIVITY.START_TIME) * 24 * 60 * 60) / 60 / 60, COALESCE(AT_FACT_OFFENDER_ACTIVITY.SLOT_CATEGORY_CODE, 'No Slot'), AT_OFFENDER_BOOKING.OFFENDER_ID_DISPLAY, AT_FACT_OFFENDER_ACTIVITY.ALLOCATED_FLAG, AT_DIM_LOCATION.UNIT_4_SHORT_DESCRIPTION, AT_OFFENDER_BOOKING.SURNAME, AT_FACT_OFFENDER_ACTIVITY.COMMENT_TEXT, AT_DIM_PROGRAMME_SERVICE.CODE, AT_DIM_SERVICE_CATEGORY.CODE, AT_DIM_PROGRAMME_TYPE.CODE, AT_DIM_ACTIVITY_STATUS.DESCRIPTION, AT_CELL.UNIT_1_CODE), dataset_ AS (SELECT ESTABLISHMENT_CODE_NK, ESTABLISHMENT_DESCRIPTION, DESCRIPTION, ACTIVITY_DESCRIPTION, ACTIVITY_SESSION_DATE, STATUS, START_TIME, END_TIME, ACTIVITY_SESSION_DURATION, SLOT_AS_DIMENSION, OFFENDER_ID_DISPLAY, ALLOCATED_FLAG, UNIT_4_SHORT_DESCRIPTION, SURNAME, COMMENT_TEXT, CODE, ACTIVITY_SERVICE_CATEGORY_CODE, COUNT_OF_OFFENDERS, ACTIVITY_CODE, ACTIVITY_SESSION_STATUS_DESC35, UNIT_1_CODE, INITCAP(ACTIVITY_DESCRIPTION) AS V_ACTIVITY_DESC, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) AS V_SCHEDULED_PRISONERS, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'ATT') AS V_ACTUAL_ATTENDED, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'ACCAB') AS V_ACCEPTABLE_ABSENCE, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'CANC') AS V_CANCELLED, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'NREQ') AS V_NOT_REQUIRED, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'UNACAB') AS V_UNACCEPT_ABSENCE, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'UNBEH') AS V_UNACCEPT_BEHAVIOUR, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'REST') AS V_REST_DAY, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS = 'COURT') AS V_COURT, COUNT(ACTIVITIES.OFFENDER_ID_DISPLAY) OVER (PARTITION BY STATUS IS NULL) AS V_NOT_RECORDED, SENTENCED_ AS V_SENTENCED_, COUNT(V_CONCAT_NOMS_AND_SESSION) AS V_SUM_SCHEDULED, CASE WHEN ACTIVITY_SESSION_STATUS_DESC35 IS NULL THEN 'Not Attended' ELSE 'Total Prisoners with' || ' ' || (ACTIVITY_SESSION_STATUS_DESC35) || ' ' || 'status' END AS V_SUM_ATTENDANCE_DISPLAY FROM dataset_base_)",
      "parameters": [
