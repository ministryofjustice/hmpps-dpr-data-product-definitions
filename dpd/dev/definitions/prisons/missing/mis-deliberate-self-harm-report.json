{
  "id": "kle1kdYAC611BjcA8VYAISgV_bQ",
  "name": "MIS Deliberate Self Harm Report",
  "metadata": {
    "version": "1.0.0",
    "tags": [
      "INC0018  v00.00.03"
    ]
  },
  "description": "Provides a detailed listing of all Deliberate Self Harm incidents, for Prisoners in an establishment, for a date range entered at run time.<br/>INC0018 - v00.00.03  Last Modified: 17/09/20",
  "datasource": [
    {
      "id": "bodmis",
      "name": "BODMIS",
      "database": "DIGITAL_PRISON_REPORTING",
      "catalog": "bodmis"
    }
  ],
  "dataset": [
    {
      "id": "3375377/DP2",
      "name": "Incidents",
      "description": "MIS Incidents",
      "datasource": "bodmis",
      "query": "dataset_base_ AS (SELECT AT_OFFENDER_BOOKING.OFFENDER_ID_DISPLAY, AT_OFFENDER_BOOKING.SURNAME, AT_OFFENDER_BOOKING.INITIALS, FLOOR((MONTHS_BETWEEN((TRUNC(CURRENT_TIMESTAMP)), (CASE WHEN AT_DOB.DAY_DATE < '31/12/9000' THEN AT_DOB.DAY_DATE END))) / 12) AS OFFENDER_AGE, CASE WHEN AT_DIM_ETHNICITY_CODES.CODE = 'MERGE' THEN 'Code Missing' WHEN AT_DIM_ETHNICITY_CODES.CODE IS NULL THEN 'Code Missing' WHEN AT_DIM_ETHNICITY_CODES.CODE = 'W8' THEN 'W3' WHEN AT_DIM_ETHNICITY_CODES.CODE = 'O1' THEN 'A4' ELSE AT_DIM_ETHNICITY_CODES.CODE END AS ETHNIC_CODE, AT_INCIDENT_ESTABLISHMENT.ESTABLISHMENT_DESCRIPTION, AT_INCIDENT_ESTABLISHMENT.ESTABLISHMENT_CODE_NK, AT_INCIDENT_DATE.DAY_DATE, TO_NUMBER(SUBSTR(AT_INCIDENT.INCIDENT_TIME, 12, 2)) AS INCIDENT_HOUR, TO_NUMBER(SUBSTR(AT_INCIDENT.INCIDENT_TIME, 15, 2)) AS INCIDENT_MINUTES, AT_INCIDENT_STATUS.INCIDENT_STATUS_DESCRIPTION, AT_INCIDENT.INCIDENT_TITLE, AT_INCIDENT.REPORT_DATE, AT_INCIDENT.INCIDENT_TEXT, INITCAP(AT_INCIDENT_TYPE.INCIDENT_TYPE_DESC) AS INCIDENT_TYPE, AT_INCIDENT.INCIDENT_CASE_ID, AT_INCIDENT_ANSWER.ANSWER_DESCRIPTION, AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID, AT_INCIDENT_QUESTIONNAIRE.RESPONSE_COMMENT_TEXT FROM BODIMIS.FACT_INCIDENT_QUESTIONNAIRE AT_INCIDENT_QUESTIONNAIRE, BODIMIS.FACT_INCIDENT AT_INCIDENT, BODIMIS.DIM_ESTABLISHMENT AT_INCIDENT_ESTABLISHMENT, BODIMIS.DIM_ETHNICITY_CODES AT_DIM_ETHNICITY_CODES, BODIMIS.DIM_OFFENDER_BOOKING AT_OFFENDER_BOOKING, BODIMIS.DIM_DATE AT_DOB, BODIMIS.DIM_DATE AT_INCIDENT_DATE, BODIMIS.DIM_INCIDENT_STATUS AT_INCIDENT_STATUS, BODIMIS.DIM_INCIDENT_TYPE AT_INCIDENT_TYPE, BODIMIS.DIM_INCIDENT_ANSWER AT_INCIDENT_ANSWER, BODIMIS.FACT_INCIDENT_PARTICIPATION AT_INCIDENT_PARTICIPATION, BODIMIS.DIM_INCIDENT_QUESTION AT_INCIDENT_QUESTION WHERE (AT_INCIDENT.INCIDENT_STATUS_SK = AT_INCIDENT_STATUS.INCIDENT_STATUS_SK) AND (AT_INCIDENT_ESTABLISHMENT.ESTABLISHMENT_SK = AT_INCIDENT.ESTABLISHMENT_SK) AND (AT_INCIDENT_DATE.DATE_SK = AT_INCIDENT.INCIDENT_DATE_SK) AND (AT_INCIDENT.INCIDENT_CASE_ID = AT_INCIDENT_PARTICIPATION.INCIDENT_CASE_ID) AND (AT_INCIDENT_PARTICIPATION.OFFENDER_BOOKING_SK (+) = AT_OFFENDER_BOOKING.OFFENDER_BOOKING_SK) AND (AT_INCIDENT_QUESTIONNAIRE.INCIDENT_CASE_ID = AT_INCIDENT.INCIDENT_CASE_ID) AND (AT_INCIDENT_ANSWER.INCIDENT_QUESTION_SK = AT_INCIDENT_QUESTION.INCIDENT_QUESTION_SK) AND (AT_INCIDENT_QUESTIONNAIRE.INCIDENT_ANSWER_SK = AT_INCIDENT_ANSWER.INCIDENT_ANSWER_SK) AND (AT_INCIDENT_PARTICIPATION.OFFENDER_BOOKING_SK IS NULL OR AT_INCIDENT_PARTICIPATION.OFFENDER_BOOKING_SK IN (SELECT CSL.OFFENDER_BOOKING_SK FROM BODIMIS.DIM_STAFF_ACCESSIBLE_CASELOAD SAC, BODIMIS.DIM_CASELOAD_SECURITY_LIST CSL WHERE SAC.CASELOAD_ID = CSL.CASELOAD_CODE AND SAC.USERNAME = (SELECT username FROM context_) AND (CSL.ENDYEAR >= TO_CHAR(CURRENT_TIMESTAMP, 'YYYY') - 6 OR CSL.ENDYEAR = '2999'))) AND (AT_INCIDENT_QUESTION.QUESTIONNAIRE_ID = AT_INCIDENT_TYPE.QUESTIONNAIRE_ID) AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_OFFENDER_BOOKING.BIRTH_DATE_SK = AT_DOB.DATE_SK) AND (AT_DIM_ETHNICITY_CODES.CODE (+) = AT_OFFENDER_BOOKING.ETHNICITY_CODE) AND (AT_OFFENDER_BOOKING.OFFENDER_BOOKING_SK IN (SELECT CSL.OFFENDER_BOOKING_SK FROM BODIMIS.DIM_STAFF_ACCESSIBLE_CASELOAD SAC, BODIMIS.DIM_CASELOAD_SECURITY_LIST CSL WHERE SAC.CASELOAD_ID = CSL.CASELOAD_CODE AND SAC.USERNAME = (SELECT username FROM context_) AND CSL.ENDYEAR >= TO_CHAR(CURRENT_TIMESTAMP, 'YYYY') - 6)) AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND (AT_INCIDENT_STATUS.INCIDENT_STATUS_ID_NK <> 'DUP') AND ((AT_INCIDENT_ESTABLISHMENT.ESTABLISHMENT_CODE_NK IN (SELECT SAC.CASELOAD_ID FROM BODIMIS.DIM_STAFF_ACCESSIBLE_CASELOAD SAC WHERE SAC.USERNAME = (SELECT username FROM context_))) AND (INITCAP(AT_INCIDENT_TYPE.INCIDENT_TYPE_DESC) = 'Deliberate Self Harm' AND AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID IN (SELECT AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID FROM BODIMIS.DIM_INCIDENT_ANSWER AT_INCIDENT_ANSWER WHERE (AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID IN (181552, 181555, 181554, 181553) OR AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID IN (182017, 180526, 182020, 180528, 182015, 182016, 182018, 180527, 180531, 180529, 180530, 182019, 3901, 182367, 182366, 182369, 182368, 182617, 182616) OR AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID IN (180734, 180733) OR AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID IN (180499, 180493, 180494, 180497, 180496, 180499, 180495, 180498) OR AT_INCIDENT_ANSWER.QUESTIONNAIRE_ANS_ID IN (182175, 182176, 182177, 182178, 182179, 182180, 182181, 182182, 182183)))) AND AT_INCIDENT_DATE.DAY_DATE >= TO_DATE('01-09-2020 00:00:00', 'DD-MM-YYYY HH24:MI:SS') AND AT_INCIDENT_DATE.DAY_DATE <= TO_DATE('17-09-2020 00:00:00', 'DD-MM-YYYY HH24:MI:SS'))), dataset_ AS (SELECT OFFENDER_ID_DISPLAY, SURNAME, INITIALS, OFFENDER_AGE, ETHNIC_CODE, ESTABLISHMENT_DESCRIPTION, ESTABLISHMENT_CODE_NK, DAY_DATE, INCIDENT_HOUR, INCIDENT_MINUTES, INCIDENT_STATUS_DESCRIPTION, INCIDENT_TITLE, REPORT_DATE, INCIDENT_TEXT, INCIDENT_TYPE, INCIDENT_CASE_ID, ANSWER_DESCRIPTION, QUESTIONNAIRE_ANS_ID, RESPONSE_COMMENT_TEXT FROM dataset_base_)",
      "parameters": [],
      "schema": {
        "field": [
          {
            "name": "OFFENDER_ID_DISPLAY",
            "type": "string",
            "display": "NOMS Number"
          },
