{
    "id": "apc001-referral-summary",
    "name": "Referral statistics associated with the Building Choices (BC) programme",
    "description": "Filter referrals by various associated parameters, So that you can analyse the current state of programme referrals",
    "metadata": {
        "author": "DPR",
        "owner": "DPR",
        "version": "0.1"
    },
    "datasource": [
        {
            "id": "athena_apc",
            "name": "Athena APC",
            "database": "public",
            "catalog": "dps_acc_pro_custody",
            "dialect": "postgres/19"
        },
        {
            "id": "datamart",
            "name": "datamart"
        }
    ],
    "dataset": [
        {
            "id": "referral-summary",
            "name": "Referral summary",
            "datasource": "athena_apc",
            "query": "SELECT c.name AS name, c.audience AS audience, r.status AS status, o.organisation_id, COUNT(r.referral_id) AS referral_count FROM referral r LEFT JOIN offering o ON r.offering_id = o.offering_id LEFT JOIN course c ON o.course_id = c.course_id WHERE r.deleted = FALSE AND (submitted_on) >= (SELECT START_DATE from prompt_) and (submitted_on) <= (SELECT END_DATE from prompt_) GROUP BY CUBE (c.name, c.audience, r.status,o.organisation_id ) ORDER BY c.name",
            "parameters": [
                {
                    "index": 0,
                    "name": "start_date",
                    "filterType": "date",
                    "reportFieldType": "date",
                    "display": "Enter Start Date",
                    "mandatory": "true"
                },
                {
                    "index": 1,
                    "name": "end_date",
                    "filterType": "date",
                    "reportFieldType": "date",
                    "display": "Enter End Date",
                    "mandatory": "true"
                }
            ],
            "schema": {
                "field": [
                    {
                        "name": "name",
                        "type": "string",
                        "display": "Name"
                    },
                    {
                        "name": "audience",
                        "type": "string",
                        "display": "Audience",
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "Sexual offence",
                                    "display": "Sexual offence"
                                },
                                {
                                    "name": "General violence offence",
                                    "display": "General violence offence"
                                }
                            ]
                        }
                    },
                    {
                        "name": "status",
                        "type": "int",
                        "display": "Status",
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "DESELECTED",
                                    "display": "DESELECTED"
                                },
                                {
                                    "name": "WITHDRAWN",
                                    "display": "WITHDRAWN"
                                },
                                {
                                    "name": "REFERRAL_STARTED",
                                    "display": "REFERRAL_STARTED"
                                }
                            ]
                        }
                    },
                    {
                        "name": "organisation_id",
                        "type": "string",
                        "display": "Org",
                        "filter": {
                            "type": "multiselect",
                            "interactive": true,
                            "dynamicoptions": {
                                "returnAsStaticOptions": true,
                                "maximumOptions": 130,
                                "dataset": "$ref:prisons",
                                "name": "code",
                                "display": "name"
                            }
                        }
                    },
                    {
                        "name": "referral_count",
                        "type": "int",
                        "display": "Count"
                    }
                ]
            }
        },
        {
            "id": "courses",
            "name": "courses",
            "datasource": "athena_apc",
            "query": "SELECT name FROM public.course WHERE withdrawn = false",
            "schema": {
                "field": [
                    {
                        "name": "name",
                        "type": "string",
                        "display": ""
                    }
                ]
            }
        },
        {
            "id": "prisons",
            "name": "prisons",
            "datasource": "datamart",
            "query": "SELECT prison_id as code,name FROM establishment.prison WHERE active = TRUE ORDER by name",
            "schema": {
                "field": [
                    {
                        "name": "code",
                        "type": "string"
                    },
                    {
                        "name": "name",
                        "type": "string"
                    }
                ]
            }
        },
        {
            "id": "individual-referrals",
            "name": "individuals",
            "datasource": "athena_apc",
            "query": " SELECT r.prison_number, forename, surname, gender, location, earliest_release_date, earliest_release_date_type, CASE WHEN earliest_release_date - current_date > 180 THEN 'No' WHEN earliest_release_date - current_date > 0 THEN 'Yes' ELSE 'N/A' END AS earliest_release_date_indicator, sentence_type, r.status, referral_id, r.submitted_on, r.additional_information, c.name, c.course_id, rs.closed FROM public.referral r LEFT JOIN person p ON p.prison_number = r.prison_number LEFT JOIN offering o ON o.offering_id = r.offering_id LEFT JOIN course c ON c.course_id = o.course_id LEFT JOIN referral_status rs ON rs.code = r.status ",
            "schema": {
                "field": [
                    {
                        "name": "prison_number",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "forename",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "surname",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "gender",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "location",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "earliest_release_date",
                        "type": "date",
                        "display": ""
                    },
                    {
                        "name": "earliest_release_date_type",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "earliest_release_date_indicator",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "sentence_type",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "status",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "referral_id",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "submitted_on",
                        "type": "date",
                        "display": ""
                    },
                    {
                        "name": "additional_information",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "name",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "course_id",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "closed",
                        "type": "string",
                        "display": ""
                    }
                ]
            }
        }
    ],
    "policy": [
        {
            "id": "access",
            "type": "access",
            "rule": [
                {
                    "effect": "permit",
                    "condition": [
                        {
                            "match": [
                                "${role}",
                                "ROLE_PRISONS_REPORTING_USER"
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "report": [],
