{
  "id" : "daily-dataset-examples",
  "name" : "Daily dataset examples",
  "description" : "Daily dataset examples",
  "schemaversion": "1.1.0",
  "metadata" : {
    "author" : "Zahoor",
    "version" : "1.2.3",
    "owner" : "DPR"
  },
  "datasource" : [
    {
      "id" : "datamart",
      "name" : "datamart"
    }
  ],
  "dataset" : [
    {
      "id" : "establishments",
      "name" : "Establishments",
      "datasource" : "datamart",
      "query" : "SELECT id as establishment_id,name as establishment_name FROM datamart.establishment_establishment where id in ('BWI','ESI','LT4','RDI','LT3','ALI','MWI')",
      "schema" : {
        "field" : [
          {
            "name" : "establishment_id",
            "type" : "string",
            "display" : "Establishment ID"
          },
          {
            "name" : "establishment_name",
            "type" : "string",
            "display" : "Establishment Name"
          }
        ]
      }
    },
    {
      "id" : "data-quality-dataset",
      "name" : "Data quality dataset",
      "datasource" : "datamart",
      "query" : "SELECT DISTINCT establishment_id, ts, has_ethnicity, ethnicity_is_missing FROM datamart.metrics._dataquality_time_series where establishment_id in ('BWI','ESI','LT4')",
      "schema" : {
        "field" : [
          {
            "name" : "establishment_id",
            "type" : "string",
            "display" : "Establishment ID"
          },
          {
            "name": "ts",
            "type": "timestamp",
            "formula": "format_date(${ts}, 'yyyy-MM-dd')",
            "display": "Date"
          },
          {
            "name" : "has_ethnicity",
            "type" : "long",
            "display" : "% prisoners with ethnicity"
          },
          {
            "name" : "ethnicity_is_missing",
            "type" : "long",
            "display" : "% prisoners without ethnicity"
          }
        ]
      }
    }
  ],
  "dashboard" : [
    {
      "id" : "bar-data-quality-dashboard-test",
      "name" : "Bar Daily line chart timeseries dashboard",
      "description" : "Bar Daily line chart timeseries dashboard",
      "dataset" : "data-quality-dataset",
      "section" : [
        {
          "id" : "bar-missing-ethnicity-section",
          "display" : "Bar Missing ethnicity",
          "description" : "Bar Number of prisoner with missing or present ethnicity data",
          "visualisation" : [
            {
              "id": "missing-ethnicity-metric-bar-visualisation",
              "type": "bar",
              "display": "Bar Missing ethnicity",
              "description" : "Bar Number of prisoner with missing or present ethnicity data",
              "column": {
                "key": [
                  {
                    "id": "$ref:establishment_id",
                    "display": "Establishmnent ID"
                  }
                ],
                "measure": [
                  {
                    "id": "$ref:has_ethnicity",
                    "display": "% of prisoners with ethnicity",
                    "unit": "percentage"
                  },
                  {
                    "id": "$ref:ethnicity_is_missing",
                    "display": "% of prisoners without ethnicity",
                    "unit": "percentage"
                  }
                ],
                "expectNull": false
              }
            }
          ]
        }
      ]
    },
