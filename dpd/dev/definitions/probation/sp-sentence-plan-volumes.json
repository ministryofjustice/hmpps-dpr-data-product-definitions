{
    "id": "sp001-sentence-plan-volumes",
    "name": "Sentence Plan data products",
    "description": "Sentence Plan creation count and page view",
    "metadata": {
        "author": "DPR",
        "owner": "DPR",
        "version": "0.1"
    },
    "datasource": [
        {
            "id": "datamart",
            "name": "datamart"
        }
    ],
    "dataset": [
        {
            "id": "active-users-count",
            "name": "Active users",
            "datasource": "datamart",
            "query": "WITH goals AS ( select created_by_user_id, count(*) AS goal_count FROM datamart.prisons.sentenceplanassessmentview_goal group by created_by_user_id ), STEPS AS ( select created_by_user_id, count(*) as step_count FROM datamart.prisons.sentenceplanassessmentview_step group by created_by_user_id ) SELECT a.created_by_user_id, count(a.id) AS agreement_count, goal_count, step_count FROM datamart.prisons.sentenceplanassessmentview_plan_agreement a LEFT JOIN goals g ON g.created_by_user_id = a.created_by_user_id LEFT JOIN steps s ON s.created_by_user_id = a.created_by_user_id GROUP BY a.created_by_user_id, goal_count, step_count ",
            "schema": {
                "field": [
                    {
                        "name": "created_by_user_id",
                        "type": "string",
                        "display": "User ID"
                    },
                    {
                        "name": "agreement_count",
                        "type": "int",
                        "display": "Agreement"
                    },
                    {
                        "name": "goal_count",
                        "type": "int",
                        "display": "Goal"
                    },
                    {
                        "name": "step_count",
                        "type": "int",
                        "display": "Step"
                    }
                ]
            }
        },
        {
            "id": "sentence-plan-count-by-date-range",
            "name": "SP summary",
            "datasource": "datamart",
            "query": "select trunc(p.created_at) as ts, '$TBC' AS link, count(p.id) as plan_count, count(a.status) as agreement_count, COUNT(CASE WHEN i.type = 'CRN' THEN 1 END) AS crn_count, COUNT(CASE WHEN i.type = 'NOMIS' THEN 1 END) AS nomis_count, COUNT(CASE WHEN a.status = 'AGREED' THEN 1 END) AS agreed_count, plan_count - agreement_count AS draft_count, COUNT(CASE WHEN a.status = 'COULD_NOT_ANSWER' THEN 1 END) AS could_not_answer_count, COUNT(CASE WHEN a.status = 'DO_NOT_AGREE' THEN 1 END) AS not_agreed_count, COUNT(CASE WHEN a.status = 'UPDATED_AGREED' THEN 1 END) AS updated_agreed_count, COUNT(CASE WHEN a.status = 'UPDATED_COULD_NOT_AGREE' THEN 1 END) AS updated_could_not_agree, round(crn_count::FLOAT4/plan_count * 100,1) as crn_pct, round(nomis_count::FLOAT4/plan_count * 100,1) as nomis_pct, round(agreed_count::FLOAT4/NULLIF(agreement_count,0) * 100,1) as agreed_pct, round(draft_count::FLOAT4/plan_count * 100,1) as draft_pct, round(could_not_answer_count::FLOAT4/NULLIF(agreement_count,0) * 100,1) as could_not_answer_pct, round(not_agreed_count::FLOAT4/NULLIF(agreement_count,0) * 100,1) as not_agreed_pct, round(updated_agreed_count::FLOAT4/NULLIF(agreement_count,0) * 100,1) as updated_agreed_count_pct, round(updated_could_not_agree::FLOAT4/NULLIF(agreement_count,0) * 100,1) as updated_could_not_agree_pct, SUM (plan_count) over (order by ts rows unbounded preceding) AS total_to_date FROM datamart.prisons.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.prisons.sentenceplanassessmentview_sentence_plan_identifier i ON i.sentence_plan_id = p.id LEFT JOIN datamart.prisons.sentenceplanassessmentview_plan_agreement a ON a.sentence_plan_id = p.snapshot_id group by ts order by ts ",
            "schema": {
                "field": [
                    {
                        "name": "ts",
                        "type": "timestamp",
                        "display": "Date",
                        "filter": {
                            "index": 0,
                            "interactive": "true",
                            "type": "daterange",
                            "default": "today(-3, months) - today()"
                        }
                    },
                    {
                        "name": "link",
                        "type": "int",
                        "display": "Link",
                        "formula": "make_url('/dpr/request-report/report/dpr_sp001-sentence-plan-volumes/sentence-plan-by-date-report/filters?filters.created_at.start=${ts}&filters.created_at.end=${ts}',${plan_count},TRUE)"
                    },
                    {
                        "name": "plan_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "agreement_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "crn_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "nomis_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "agreed_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "draft_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "could_not_answer_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "not_agreed_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "updated_agreed_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "updated_could_not_agree",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "crn_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "nomis_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "agreed_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "draft_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "could_not_answer_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "not_agreed_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "updated_agreed_count_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "updated_could_not_agree_pct",
                        "type": "float",
                        "display": "Count"
                    },
                    {
                        "name": "total_to_date",
                        "type": "int",
                        "display": "Total"
                    }
                ]
            }
        },
        {
            "id": "sentence-plan-by-date",
            "name": "SP detail",
            "datasource": "datamart",
            "query": "SELECT p.id, trunc(p.created_at) AS created_at, trunc(p.updated_at) AS updated_at, CASE WHEN a.status IS NULL THEN 'DRAFT' ELSE a.status END AS status, region_code, COUNT(CASE WHEN g.area_of_need = 'ACCOMMODATION' THEN 1 END) AS accommodation_count, COUNT(CASE WHEN g.area_of_need = 'DRUG_USE' THEN 1 END) AS drug_count, COUNT(CASE WHEN g.area_of_need = 'FINANCES' THEN 1 END) AS finance_count, COUNT(CASE WHEN g.area_of_need = 'ALCOHOL_USE' THEN 1 END) AS alcohol_count, COUNT(CASE WHEN g.area_of_need = 'HEALTH_AND_WELLBEING' THEN 1 END) AS health_count, COUNT(CASE WHEN g.area_of_need = 'PERSONAL_RELATIONSHIPS_AND_COMMUNITY' THEN 1 END) AS personal_count, COUNT(CASE WHEN g.area_of_need = 'EMPLOYMENT_AND_EDUCATION' THEN 1 END) AS employment_count, COUNT(CASE WHEN g.area_of_need = 'THINKING_BEHAVIOURS_AND_ATTITUDES' THEN 1 END) AS thinking_count, count(g.id) as total_goal_count FROM datamart.prisons.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.prisons.sentenceplanassessmentview_goal g ON  g.sentence_plan_id = p.snapshot_id LEFT JOIN datamart.prisons.sentenceplanassessmentview_plan_agreement a ON  a.sentence_plan_id = p.snapshot_id GROUP BY  (p.id, p.created_at,p.updated_at, a.status,region_code)",
            "schema": {
                "field": [
                    {
                        "name": "id",
                        "type": "string",
                        "display": "ID"
                    },
                    {
                        "name": "created_at",
                        "type": "date",
                        "display": "Created"
                    },
                    {
                        "name": "updated_at",
                        "type": "string",
                        "display": "Area of need"
                    },
                    {
                        "name": "status",
                        "type": "string",
                        "display": "Status"
                    },
                    {
                        "name": "region_code",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "accommodation_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "drug_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "finance_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "alcohol_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "health_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "personal_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "employment_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "thinking_count",
                        "type": "string",
                        "display": "thinking_count"
                    },
                    {
                        "name": "total_goal_count",
                        "type": "int",
                        "display": "Goals"
                    }
                ]
            }
        }
    ],
    "policy": [
        {
            "id": "lao",
            "type": "lao",
            "rule": [
                {
                    "effect": "permit",
                    "condition": []
                }
            ]
        },
        {
            "id": "access",
            "type": "access",
            "rule": [
                {
                    "effect": "permit",
                    "condition": [
