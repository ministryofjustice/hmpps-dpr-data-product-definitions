{
    "id": "sp001-sentence-plan-volumes",
    "name": "Sentence Plan data products",
    "description": "Sentence Plan creation count and page view",
    "metadata": {
        "author": "DPR",
        "owner": "DPR",
        "version": "0.1"
    },
    "datasource": [
        {
            "id": "datamart",
            "name": "datamart"
        }
    ],
    "dataset": [
        {
            "id": "active-users-count",
            "name": "Active users",
            "datasource": "datamart",
            "query": "WITH goals AS ( select created_by_user_id, count(*) AS goal_count FROM datamart.prisons.sentenceplanassessmentview_goal group by created_by_user_id ), STEPS AS ( select created_by_user_id, count(*) as step_count FROM datamart.prisons.sentenceplanassessmentview_step group by created_by_user_id ) SELECT a.created_by_user_id, count(a.id) AS agreement_count, goal_count, step_count FROM datamart.prisons.sentenceplanassessmentview_plan_agreement a LEFT JOIN goals g ON g.created_by_user_id = a.created_by_user_id LEFT JOIN steps s ON s.created_by_user_id = a.created_by_user_id GROUP BY a.created_by_user_id, goal_count, step_count ",
            "schema": {
                "field": [
                    {
                        "name": "created_by_user_id",
                        "type": "string",
                        "display": "User ID"
                    },
                    {
                        "name": "agreement_count",
                        "type": "int",
                        "display": "Agreement"
                    },
                    {
                        "name": "goal_count",
                        "type": "int",
                        "display": "Goal"
                    },
                    {
                        "name": "step_count",
                        "type": "int",
                        "display": "Step"
                    }
                ]
            }
        },
        {
            "id": "sentence-plan-count-by-date-range",
            "name": "SP summary",
            "datasource": "datamart",
            "query": "select trunc(p.created_at) as ts, '$TBC' AS link, count(*) as daily_count, SUM (daily_count) over (order by ts rows unbounded preceding) AS total_to_date FROM datamart.prisons.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.prisons.sentenceplanassessmentview_goal g ON g.sentence_plan_id = p.id WHERE exists (select p.id from datamart.prisons.sentenceplanassessmentview_goal AS g) GROUP BY ts ORDER BY ts",
            "schema": {
                "field": [
                    {
                        "name": "ts",
                        "type": "timestamp",
                        "display": "Date",
                        "filter": {
                            "index": 0,
                            "interactive": "true",
                            "type": "daterange",
                            "default": "today(-3, months) - today()"
                        }
                    },
                    {
                        "name": "link",
                        "type": "int",
                        "display": "Link",
                        "formula": "make_url('/dpr/request-report/report/dpr_sp001-sentence-plan-volumes/sentence-plan-by-date-report/filters?filters.created_at.start=${ts}&filters.created_at.end=${ts}',${daily_count},TRUE)"
                    },
                    {
                        "name": "daily_count",
                        "type": "int",
                        "display": "Count"
                    },
                    {
                        "name": "total_to_date",
                        "type": "int",
                        "display": "Total"
                    }
                ]
            }
        },
        {
            "id": "sentence-plan-by-date",
            "name": "SP detail",
            "datasource": "datamart",
            "query": "SELECT p.id, trunc(p.created_at) AS created_at, trunc(p.updated_at) AS updated_at, CASE WHEN a.status IS NULL THEN 'DRAFT' ELSE a.status END AS status, region_code, COUNT(CASE WHEN g.area_of_need = 'ACCOMMODATION' THEN 1 END) AS accommodation_count, COUNT(CASE WHEN g.area_of_need = 'DRUG_USE' THEN 1 END) AS drug_count, COUNT(CASE WHEN g.area_of_need = 'FINANCES' THEN 1 END) AS finance_count, COUNT(CASE WHEN g.area_of_need = 'ALCOHOL_USE' THEN 1 END) AS alcohol_count, COUNT(CASE WHEN g.area_of_need = 'HEALTH_AND_WELLBEING' THEN 1 END) AS health_count, COUNT(CASE WHEN g.area_of_need = 'PERSONAL_RELATIONSHIPS_AND_COMMUNITY' THEN 1 END) AS personal_count, COUNT(CASE WHEN g.area_of_need = 'EMPLOYMENT_AND_EDUCATION' THEN 1 END) AS employment_count, COUNT(CASE WHEN g.area_of_need = 'THINKING_BEHAVIOURS_AND_ATTITUDES' THEN 1 END) AS thinking_count, count(g.id) as total_goal_count FROM datamart.prisons.sentenceplanassessmentview_sentence_plan p LEFT JOIN datamart.prisons.sentenceplanassessmentview_goal g ON  g.sentence_plan_id = p.snapshot_id LEFT JOIN datamart.prisons.sentenceplanassessmentview_plan_agreement a ON  a.sentence_plan_id = p.snapshot_id GROUP BY  (p.id, p.created_at,p.updated_at, a.status,region_code)",
            "schema": {
                "field": [
                    {
                        "name": "id",
                        "type": "string",
                        "display": "ID"
                    },
                    {
                        "name": "created_at",
                        "type": "date",
                        "display": "Created"
                    },
                    {
                        "name": "updated_at",
                        "type": "string",
                        "display": "Area of need"
                    },
                    {
                        "name": "status",
                        "type": "string",
                        "display": "Status"
                    },
                    {
                        "name": "region_code",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "accommodation_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "drug_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "finance_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "alcohol_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "health_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "personal_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "employment_count",
                        "type": "string",
                        "display": ""
                    },
                    {
                        "name": "thinking_count",
                        "type": "string",
                        "display": "thinking_count"
                    },
                    {
                        "name": "total_goal_count",
                        "type": "int",
                        "display": "Goals"
                    }
                ]
            }
        }
    ],
    "policy": [
        {
            "id": "lao",
            "type": "lao",
            "rule": [
                {
                    "effect": "permit",
                    "condition": []
                }
            ]
        },
        {
            "id": "access",
            "type": "access",
            "rule": [
                {
                    "effect": "permit",
                    "condition": [
                        {
                            "match": [
                                "${role}",
                                "ARNS_DIGITAL_VIEW"
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "report": [
        {
            "id": "sentence-plan-by-date-report",
            "name": "Sentence Plan creation date by prefiltered date",
            "description": "Sentence Plan creation date by date",
            "classification": "Official",
            "version": "1.0.0",
            "render": "HTML",
            "dataset": "$ref:sentence-plan-by-date",
            "feature": [
                {
                    "type": "share|save|email|print|download"
                }
            ],
            "metadata": {
                "hints": [
                    "interactive"
                ]
            },
            "specification": {
                "template": "list",
                "field": [
                    {
                        "name": "$ref:id",
                        "display": "ID",
                        "formula": "",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": true
                    },
                    {
                        "name": "$ref:created_at",
                        "display": "Created",
                        "formula": "",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false,
                        "filter": {
                            "index": 1,
                            "type": "daterange"
                        }
                    },
                    {
                        "name": "$ref:status",
                        "display": "Status",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false,
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "DRAFT",
                                    "display": "Draft"
                                },
                                {
                                    "name": "AGREED",
                                    "display": "Agreed"
                                },
                                {
                                    "name": "COULD_NOT_ANSWER",
                                    "display": "Could not answer"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:accommodation_count",
                        "display": "Accommodation",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false,
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "0",
                                    "display": "0"
                                },
                                {
                                    "name": "1",
                                    "display": "1"
                                }
                            ]
                        }
                    },
                    {
                        "name": "$ref:drug_count",
                        "display": "Drug",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:finance_count",
                        "display": "Finance",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:alcohol_count",
                        "display": "Alcohol",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:health_count",
                        "display": "Health",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:personal_count",
                        "display": "Personal",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:employment_count",
                        "display": "Employment",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:thinking_count",
                        "display": "Thinking",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:total_goal_count",
                        "display": "Total",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false,
                        "filter": {
                            "index": 1,
                            "type": "multiselect",
                            "interactive": "true",
                            "staticoptions": [
                                {
                                    "name": "0",
                                    "display": "0 Goals"
                                }
                            ]
                        }
                    }
                ]
            }
        },
        {
            "id": "sentence-plan-by-user-report",
            "name": "Sentence Plan created by users report",
            "description": "Sentence Plan agreements, goals and steps created by user report",
            "classification": "Official",
            "version": "1.0.0",
            "render": "HTML",
            "dataset": "$ref:active-users-count",
            "feature": [
                {
                    "type": "share|save|email|print|download"
                }
            ],
            "metadata": {
                "hints": [
                    "interactive"
                ]
            },
            "specification": {
                "template": "list",
                "field": [
                    {
                        "name": "$ref:created_by_user_id",
                        "display": "ID",
                        "formula": "",
                        "visible": "true",
                        "sortable": false,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:agreement_count",
                        "display": "Agreement",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": true,
                        "sortdirection": "desc"
                    },
                    {
                        "name": "$ref:goal_count",
                        "display": "Goals",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false
                    },
                    {
                        "name": "$ref:step_count",
                        "display": "Steps",
                        "visible": "true",
                        "sortable": true,
                        "defaultsort": false
                    }
                ]
            }
        }
    ],
    "dashboard": [
        {
            "id": "sp-creation-count",
            "name": "Sentence Plan creation count",
            "description": "Sentence Plan creation count",
            "dataset": "sentence-plan-count-by-date-range",
            "section": [
                {
                    "id": "list3",
                    "display": "Sentence plan creation count",
                    "visualisation": [
                        {
                            "id": "pc1",
                            "type": "list",
                            "display": "Plan summary by date",
                            "option": {
                                "showLatest": false
                            },
                            "column": {
                                "key": [
                                    {
                                        "id": "$ref:ts",
                                        "display": "Date"
                                    }
                                ],
                                "measure": [
                                    {
                                        "id": "$ref:ts",
                                        "display": "Date"
                                    },
                                    {
                                        "id": "$ref:link",
                                        "display": "Count"
                                    },
                                    {
                                        "id": "$ref:total_to_date",
                                        "display": "Total to date"
                                    }
                                ],
                                "expectNull": false
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "sp-active-users",
            "name": "Sentence Plan active users",
            "description": "Active users by agreement, goals and steps",
            "dataset": "active-users-count",
            "section": [
                {
                    "id": "list3",
                    "display": "Active users by agreement, goals and steps",
                    "visualisation": [
                        {
                            "id": "pc1",
                            "type": "list",
                            "display": "Active users",
                            "option": {
                                "showLatest": false
                            },
                            "column": {
                                "key": [
                                    {
                                        "id": "$ref:created_by_user_id",
                                        "display": "User ID"
                                    }
                                ],
                                "measure": [
                                    {
                                        "id": "$ref:created_by_user_id",
                                        "display": "User ID"
                                    },
                                    {
                                        "id": "$ref:agreement_count",
                                        "display": "Agreements"
                                    },
                                    {
                                        "id": "$ref:goal_count",
                                        "display": "Goals"
                                    },
                                    {
                                        "id": "$ref:step_count",
                                        "display": "Steps"
                                    }
                                ],
                                "expectNull": false
                            }
                        }
                    ]
                }
            ]
        }
    ]
}